{"version":3,"kind":"Notebook","sha256":"8ae8cfa1f9a2446e0ef8d7375f1ea472a6a16fae573d27d0dda547e6292fa7b4","slug":"laboratory-task-2","location":"/Laboratory Task 2.ipynb","dependencies":[],"frontmatter":{"kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"numbering":{"title":{"offset":1}},"exports":[{"format":"ipynb","filename":"Laboratory Task 2.ipynb","url":"/Laboratory Task 2-adb73ab34c0e24e82f1b37a429e30a2a.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"div","class":"alert alert-block alert-success","style":{"fontFamily":"Times New Roman"},"children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"Laboratory Task 2","key":"RogyPPr0N9"}],"key":"WqLfxxxsRS"}],"identifier":"laboratory-task-2","label":"Laboratory Task 2","html_id":"laboratory-task-2","implicit":true,"key":"oDp1zK39dA"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Instruction:","key":"ne88qbBUTY"}],"key":"x7y4hu1rEB"},{"type":"text","value":" Perform a single forward pass and compute for the error.","key":"djCzelehrx"}],"key":"CC6RMjH1e3"},{"type":"div","class":"math-display","children":[{"type":"text","value":"x = \\begin{bmatrix} 1 \\\\ 0 \\\\ 1 \\end{bmatrix}","key":"efCMzw5m96"}],"key":"vYGzBziKN7"},{"type":"div","class":"math-display","children":[{"type":"text","value":"y = \\begin{bmatrix} 1 \\end{bmatrix}","key":"UQKdGwpKUR"}],"key":"MRtl3xPzcD"},{"type":"div","class":"math-display","children":[{"type":"text","value":"f=max(0, Z_n)","key":"oi1VTA6FDJ"}],"key":"BtffoA6Idx"},{"type":"code","lang":"python","meta":null,"value":"\\text{hidden unit weights} = \n\\begin{bmatrix}\nw_{11} = 0.2 && w_{12} = -0.3 \\\\\nw_{13} = 0.4 && w_{14} = 0.1 \\\\\nw_{15} = -0.5 && w_{16} = 0.2\n\\end{bmatrix}","key":"onWuUa24Lz"},{"type":"code","lang":"python","meta":null,"value":"\\text{output unit weights} = \n\\begin{bmatrix}\nw_{21} = -0.3 \\\\\nw_{22} = -0.2\n\\end{bmatrix}","key":"GN3HIeOwHu"},{"type":"code","lang":"python","meta":null,"value":"\\theta = \n\\begin{bmatrix}\n\\theta_{1} = -0.4 \\\\\n\\theta_{2} = 0.2 \\\\\n\\theta_{3} = 0.1\n\\end{bmatrix}","key":"EcE5acMLqu"}],"key":"uVh4t2vB9Q"}],"key":"WH11UHaNWP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\n\ndef relu(z):\n    return np.maximum(0, z)\n\n# Inputs\nx = np.array([1, 0, 1], dtype=float)   # shape (3,)\ny = np.array([1], dtype=float)         # shape (1,)\n\n# Hidden unit weights: 3 inputs -> 2 hidden units\nW1 = np.array([\n    [0.2, -0.3],\n    [0.4,  0.1],\n    [-0.5, 0.2]\n])\n\n# Output unit weights: 2 hidden units -> 1 output\nW2 = np.array([\n    [-0.3],\n    [-0.2]\n])\n\n# Biases/thresholds: theta1, theta2 for hidden; theta3 for output\ntheta = np.array([-0.4, 0.2, 0.1])\n\nb1 = theta[:2]   # hidden biases\nb2 = theta[2]    # output bias\n\n# Forward pass\nz1 = x @ W1 + b1\nh = relu(z1)\n\nz2 = h @ W2 + b2\ny_hat = relu(z2)\n\n# Error\nerror = (y - y_hat) ** 2\nhalf_error = 0.5 * error\n\nprint(\"z1 =\", z1)\nprint(\"h =\", h)\nprint(\"z2 =\", z2)\nprint(\"y_hat =\", y_hat)\nprint(\"error =\", error)\nprint(\"half_error =\", half_error)","key":"gVvMnnuzM2"},{"type":"outputs","id":"dGTAnHs22AvZBP6c0cKVR","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"z1 = [-0.7  0.1]\nh = [0.  0.1]\nz2 = [0.08]\ny_hat = [0.08]\nerror = [0.8464]\nhalf_error = [0.4232]\n"},"children":[],"key":"advZrwDinS"}],"key":"AHgq0D24xE"}],"key":"kQ9OM5B9SQ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"z1 = [-0.7  0.1]\nh = [0.  0.1]\nz2 = [0.08]\ny_hat = [0.08]\nerror = [0.8464]\nhalf_error = [0.4232]","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sT